Cell[BoxData[{
 RowBox[{
  RowBox[{"setPointRPM", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ToExpression", "@", 
        RowBox[{"StringDelete", "[", 
         RowBox[{"#", ",", "\"\<RPM\>\""}], "]"}]}], "&"}], "@", 
      RowBox[{"StringDelete", "[", 
       RowBox[{"#", ",", "fileFormat"}], "]"}]}], "&"}], "@", "dataFile"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"measuredRPM", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Total", "@", "signalRPMpeakMask"}], "/", "2"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"timeStepMiliseconds", "*", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Length", "@", "signalRPMpeakMask"}], "-", "1"}], ")"}], 
        "/", "1000"}], "/", "60"}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"errorRelativeRPM", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"#", "-", "setPointRPM"}], "]"}], "/", "#"}], "&"}], "@", 
    "measuredRPM"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"errorRelativeRPM", "//", "PercentForm"}]}], "Input",
