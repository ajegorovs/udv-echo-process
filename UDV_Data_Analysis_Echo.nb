Cell[BoxData[{
 RowBox[{
  RowBox[{"signalRPMthreshold", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"signalThresholdFactor", "*", 
      RowBox[{"FindThreshold", "[", 
       RowBox[{"#", ",", 
        RowBox[{"Method", "\[Rule]", "\"\<Entropy\>\""}]}], "]"}]}], "&"}], 
