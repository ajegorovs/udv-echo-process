Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testImagePair", "=", 
     RowBox[{"imagesParticlesCorrected", "[", 
      RowBox[{"[", 
       RowBox[{"k", ";;", 
        RowBox[{"k", "+", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", ",", "h"}], "}"}], "=", 
